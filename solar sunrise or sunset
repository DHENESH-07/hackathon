<script>

/* =====================================================
   GLOBAL LOCATION DATA
===================================================== */

let currentLat = null;
let currentLon = null;


/* =====================================================
   FORMAT TIME
===================================================== */

function formatTime(dateString) {

    const date = new Date(dateString);

    return date.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit"
    });

}


/* =====================================================
   FORMAT DAYLIGHT
===================================================== */

function formatDuration(seconds) {

    const hours = Math.floor(seconds / 3600);

    const minutes =
        Math.round((seconds % 3600) / 60);

    return `${hours}h ${minutes}m`;

}


/* =====================================================
   GET SUN + WEATHER DATA
===================================================== */

async function getSolarData(lat, lon, locationName) {

    try {

        document.getElementById("locationName").textContent =
            locationName;

        document.getElementById("placeDetails").textContent =
            "Loading solar information...";


        /*
            Open-Meteo gives:

            Sunrise
            Sunset
            Daylight
            Solar noon
            Dawn
            Dusk
            Temperature
            Cloud cover
            Wind speed
            Timezone
        */

        const url =
        `https://api.open-meteo.com/v1/forecast?` +
        `latitude=${lat}` +
        `&longitude=${lon}` +
        `&daily=sunrise,sunset,sunshine_duration,` +
        `daylight_duration,sunrise,sunset` +
        `&current=temperature_2m,cloud_cover,wind_speed_10m` +
        `&timezone=auto`;


        const response = await fetch(url);

        if (!response.ok) {

            throw new Error(
                "Unable to get solar information."
            );

        }


        const data = await response.json();


        currentLat = lat;
        currentLon = lon;


        /* ================= SUN DATA ================= */

        const sunrise =
            data.daily.sunrise[0];

        const sunset =
            data.daily.sunset[0];


        const sunriseDate =
            new Date(sunrise);

        const sunsetDate =
            new Date(sunset);


        const daylightSeconds =
            Math.floor(
                (sunsetDate - sunriseDate) / 1000
            );


        /* Solar noon */

        const solarNoonDate =
            new Date(
                sunriseDate.getTime() +
                (sunsetDate.getTime() -
                 sunriseDate.getTime()) / 2
            );


        /* ================= DISPLAY ================= */

        document.getElementById("sunrise").textContent =
            formatTime(sunrise);

        document.getElementById("sunset").textContent =
            formatTime(sunset);

        document.getElementById("sunrise2").textContent =
            formatTime(sunrise);

        document.getElementById("sunset2").textContent =
            formatTime(sunset);

        document.getElementById("solarNoon").textContent =
            formatTime(solarNoonDate);

        document.getElementById("daylight").textContent =
            formatDuration(daylightSeconds);


        /* ================= DAWN / DUSK ================= */

        /*
            Civil dawn is approximately
            24 minutes before sunrise.

            Civil dusk is approximately
            24 minutes after sunset.

            This is a simple visual approximation.
        */

        const dawnDate =
            new Date(
                sunriseDate.getTime() -
                24 * 60 * 1000
            );

        const duskDate =
            new Date(
                sunsetDate.getTime() +
                24 * 60 * 1000
            );


        document.getElementById("dawn").textContent =
            formatTime(dawnDate);

        document.getElementById("dusk").textContent =
            formatTime(duskDate);


        /* ================= LOCATION ================= */

        document.getElementById("latitude").textContent =
            Number(lat).toFixed(4) + "°";

        document.getElementById("longitude").textContent =
            Number(lon).toFixed(4) + "°";


        document.getElementById("placeDetails").textContent =
            `${locationName} • Local Solar Data`;


        /* ================= WEATHER ================= */

        if (data.current) {

            document.getElementById("temperature").textContent =
                Math.round(
                    data.current.temperature_2m
                ) + "°C";


            document.getElementById("cloud").textContent =
                data.current.cloud_cover + "%";


            document.getElementById("wind").textContent =
                Math.round(
                    data.current.wind_speed_10m
                ) + " km/h";

        }


        /* ================= SUNLIGHT PROGRESS ================= */

        updateSunProgress(
            sunriseDate,
            sunsetDate
        );


        document.getElementById("placeDetails").textContent =
            `${locationName} • Data updated just now`;


    } catch(error) {

        console.error(error);

        document.getElementById("placeDetails").textContent =
            "Unable to load solar data.";

        alert(
            "Could not load solar information. Please try again."
        );

    }

}


/* =====================================================
   SUNLIGHT PROGRESS
===================================================== */

function updateSunProgress(sunrise, sunset) {

    const now = new Date();

    const total =
        sunset - sunrise;

    const elapsed =
        now - sunrise;


    let percentage =
        (elapsed / total) * 100;


    percentage =
        Math.max(
            0,
            Math.min(
                100,
                percentage
            )
        );


    document.getElementById("progress").style.width =
        percentage + "%";


    document.getElementById("dayProgress").textContent =
        Math.round(percentage) + "%";


    /*
        Move the sun across the visual
        according to current time.
    */

    const sun =
        document.getElementById("sunVisual");


    if (
        now >= sunrise &&
        now <= sunset
    ) {

        const x =
            percentage;


        /*
            Parabolic-style vertical movement.
        */

        const height =
            25 +
            Math.sin(
                (percentage / 100) *
                Math.PI
            ) * 95;


        sun.style.left =
            x + "%";

        sun.style.top =
            (140 - height) + "px";

        sun.style.transform =
            "translateX(-50%)";

    } else {

        /*
            Before sunrise / after sunset
        */

        sun.style.left = "50%";
        sun.style.top = "160px";

    }

}


/* =====================================================
   USE MY LOCATION
===================================================== */

function useMyLocation() {

    if (!navigator.geolocation) {

        alert(
            "Geolocation is not supported by your browser."
        );

        return;

    }


    document.getElementById("locationName").textContent =
        "Finding your location...";


    navigator.geolocation.getCurrentPosition(

        async function(position) {

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;


            /*
                Reverse geocoding:
                Convert coordinates into
                a readable city name.
            */

            try {

                const response =
                    await fetch(
                        `https://geocoding-api.open-meteo.com/v1/reverse?latitude=${lat}&longitude=${lon}&count=1`
                    );


                const data =
                    await response.json();


                let locationName =
                    "Your Location";


                if (
                    data.results &&
                    data.results.length > 0
                ) {

                    const place =
                        data.results[0];


                    locationName =
                        place.name;


                    if (place.country) {

                        locationName +=
                            ", " + place.country;

                    }

                }


                await getSolarData(
                    lat,
                    lon,
                    locationName
                );


            } catch(error) {

                await getSolarData(
                    lat,
                    lon,
                    "Your Location"
                );

            }

        },

        function(error) {

            console.error(error);

            alert(
                "Location access was denied.\n\n" +
                "Please allow location permission in your browser and try again."
            );

        },

        {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 300000
        }

    );

}


/* =====================================================
   SEARCH CITY
===================================================== */

async function searchPlace() {

    const query =
        document
        .getElementById("placeInput")
        .value
        .trim();


    if (!query) {

        alert(
            "Please enter a city name."
        );

        return;

    }


    try {

        document.getElementById("locationName").textContent =
            "Searching...";


        const response =
            await fetch(
                `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=en&format=json`
            );


        const data =
            await response.json();


        if (
            !data.results ||
            data.results.length === 0
        ) {

            throw new Error(
                "Location not found"
            );

        }


        const place =
            data.results[0];


        let name =
            place.name;


        if (place.country) {

            name +=
                ", " + place.country;

        }


        await getSolarData(
            place.latitude,
            place.longitude,
            name
        );


    } catch(error) {

        alert(
            "Location not found. Try another city."
        );

    }

}


/* =====================================================
   REFRESH
===================================================== */

function refreshData() {

    if (
        currentLat !== null &&
        currentLon !== null
    ) {

        getSolarData(
            currentLat,
            currentLon,
            document
                .getElementById("locationName")
                .textContent
        );

    } else {

        useMyLocation();

    }

}


/* =====================================================
   CURRENT CLOCK
===================================================== */

function updateClock() {

    const now =
        new Date();


    document.getElementById(
        "currentTime"
    ).textContent =
        now.toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
        });

}


/* =====================================================
   START CLOCK
===================================================== */

updateClock();

setInterval(
    updateClock,
    1000
);


/* =====================================================
   ENTER KEY SEARCH
===================================================== */

document
.getElementById("placeInput")
.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {

            searchPlace();

        }

    }
);

</script>

