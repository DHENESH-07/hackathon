    ["New York, USA",40.7128,-74.0060],["Los Angeles, USA",34.0522,-118.2437],["Chicago, USA",41.8781,-87.6298],
    ["Anchorage, USA",61.2181,-149.9003],["Miami, USA",25.7617,-80.1918],["Toronto, Canada",43.6532,-79.3832],
    ["Vancouver, Canada",49.2827,-123.1207],["Iqaluit, Canada",63.7467,-68.5170],["Mexico City, Mexico",19.4326,-99.1332],
    ["Rio de Janeiro, Brazil",-22.9068,-43.1729],["São Paulo, Brazil",-23.5505,-46.6333],["Buenos Aires, Argentina",-34.6037,-58.3816],
    ["Santiago, Chile",-33.4489,-70.6693],["Lima, Peru",-12.0464,-77.0428],["Bogotá, Colombia",4.7110,-74.0721],
    ["Ushuaia, Argentina",-54.8019,-68.3030],["Nuuk, Greenland",64.1836,-51.7214],["Longyearbyen, Svalbard",78.2232,15.6469],
    ["Quito, Ecuador",-0.1807,-78.4678],["Athens, Greece",37.9838,23.7275],
    ["Vienna, Austria",48.2082,16.3738],["Warsaw, Poland",52.2297,21.0122],["Dublin, Ireland",53.3498,-6.2603],
    ["Lisbon, Portugal",38.7223,-9.1393],["Zurich, Switzerland",47.3769,8.5417]
  ];

  const els = {};
  ['cityInput','suggestions','locateBtn','placeName','placeCoords','arcSvg','durationNum','durationDelta',
   'sunriseTime','noonTime','sunsetTime','dateInput','todayBtn','yearSvg','compassSvg','compAlt','compAz',
   'chipAlt','chipAz','insightBox','updatedAt','greeting'].forEach(id => els[id] = document.getElementById(id));

  let current = { name: "Chennai, India", lat: 13.0827, lon: 80.2707 };

  function toJulian(date){ return date.getTime()/86400000 + 2440587.5; }
  function fromJulian(J){ return new Date((J - 2440587.5) * 86400000); }
  function julianFromYMD(y, m, d){
    const a = Math.floor((14 - m)/12);
    const yy = y + 4800 - a;
    const mm = m + 12*a - 3;
    return d + Math.floor((153*mm+2)/5) + 365*yy + Math.floor(yy/4) - Math.floor(yy/100) + Math.floor(yy/400) - 32045;
  }
  const rad = Math.PI/180, deg = 180/Math.PI;

  function sunTimes(y, m, d, lat, lon){
    const Jdate = julianFromYMD(y, m, d);
    const n = Jdate - 2451545.0 + 0.0008;
    const Jstar = n - lon/360;
    const M = ((357.5291 + 0.98560028 * Jstar) % 360 + 360) % 360;
    const Mrad = M*rad;
    const C = 1.9148*Math.sin(Mrad) + 0.02*Math.sin(2*Mrad) + 0.0003*Math.sin(3*Mrad);
    const lambda = ((M + C + 180 + 102.9372) % 360 + 360) % 360;
    const lambdaRad = lambda*rad;
    const Jtransit = 2451545.0 + Jstar + 0.0053*Math.sin(Mrad) - 0.0069*Math.sin(2*lambdaRad);
    const sinDelta = Math.sin(lambdaRad)*Math.sin(23.44*rad);
    const delta = Math.asin(sinDelta);
    const latRad = lat*rad;
    const cosOmega = (Math.sin(-0.83*rad) - Math.sin(latRad)*Math.sin(delta)) / (Math.cos(latRad)*Math.cos(delta));
    if (cosOmega > 1) return { polar:'night', transit: fromJulian(Jtransit) };
    if (cosOmega < -1) return { polar:'day', transit: fromJulian(Jtransit) };
    const omega = Math.acos(cosOmega)*deg;
    const Jrise = Jtransit - omega/360, Jset = Jtransit + omega/360;
    return { sunrise: fromJulian(Jrise), sunset: fromJulian(Jset), transit: fromJulian(Jtransit), durationHours: (Jset-Jrise)*24 };
  }

  function solarPosition(date, lat, lon){
    const JD = toJulian(date);
    const n = JD - 2451545.0;
    const L = ((280.460 + 0.9856474*n) % 360 + 360) % 360;
    const g = ((357.528 + 0.9856003*n) % 360 + 360) % 360;
    const gRad = g*rad;
    const lambdaSun = L + 1.915*Math.sin(gRad) + 0.020*Math.sin(2*gRad);
    const lambdaRad = lambdaSun*rad;
    const epsilon = (23.439 - 0.0000004*n)*rad;
    const alphaRad = Math.atan2(Math.cos(epsilon)*Math.sin(lambdaRad), Math.cos(lambdaRad));
    const deltaRad = Math.asin(Math.sin(epsilon)*Math.sin(lambdaRad));
    const GMST = ((280.46061837 + 360.98564736629*n) % 360 + 360) % 360;
    const alphaDeg = ((alphaRad*deg)%360+360)%360;
    let H = GMST + lon - alphaDeg;
    H = ((H+180)%360+360)%360 - 180;
    const Hrad = H*rad, latRad = lat*rad;
    const sinAlt = Math.sin(latRad)*Math.sin(deltaRad) + Math.cos(latRad)*Math.cos(deltaRad)*Math.cos(Hrad);
    const alt = Math.asin(Math.min(Math.max(sinAlt,-1),1));
    const cosAz = (Math.sin(deltaRad) - Math.sin(alt)*Math.sin(latRad)) / (Math.cos(alt)*Math.cos(latRad));
    let az = Math.acos(Math.min(Math.max(cosAz,-1),1));
    if (Math.sin(Hrad) > 0) az = 2*Math.PI - az;
    return { altitude: alt*deg, azimuth: az*deg };
  }

  function tzOffsetHours(lon){ return Math.round(lon/15); }
  function fmtLocalTime(utcDate, lon){
    const off = tzOffsetHours(lon);
    const shifted = new Date(utcDate.getTime() + off*3600000);
    let h = shifted.getUTCHours(), m = shifted.getUTCMinutes();
    const ampm = h >= 12 ? 'PM' : 'AM';
    let h12 = h % 12; if (h12 === 0) h12 = 12;
    return h12 + ':' + String(m).padStart(2,'0') + ' ' + ampm;
  }
  function fmtDuration(hoursFloat){
    const totalMin = Math.round(hoursFloat*60);
    const h = Math.floor(totalMin/60), m = totalMin%60;
    return h + 'h ' + String(m).padStart(2,'0') + 'm';
  }

  function drawArc(sunrise, sunset, polar){
    const ns='http://www.w3.org/2000/svg', w=900,h=150,cx=w/2,cy=132,r=118;
    els.arcSvg.innerHTML='';
    const g = document.createElementNS(ns,'g');
    const path = document.createElementNS(ns,'path');
    path.setAttribute('d', `M ${cx-r} ${cy} A ${r} ${r} 0 0 1 ${cx+r} ${cy}`);
    path.setAttribute('fill','none'); path.setAttribute('stroke','#F5A742');
    path.setAttribute('stroke-width','1.5'); path.setAttribute('stroke-dasharray','2 7');
    path.setAttribute('stroke-opacity', polar==='night' ? '0.18':'0.55'); path.setAttribute('stroke-linecap','round');
    g.appendChild(path);

    const horizon = document.createElementNS(ns,'line');
    horizon.setAttribute('x1',cx-r-30); horizon.setAttribute('x2',cx+r+30);
    horizon.setAttribute('y1',cy); horizon.setAttribute('y2',cy);
    horizon.setAttribute('stroke','#ffffff'); horizon.setAttribute('stroke-opacity','0.08');
    g.appendChild(horizon);

    if (polar !== 'night' && polar !== 'day'){
      const dayMs = sunset - sunrise;
      const frac = (new Date().getTime() - sunrise.getTime())/dayMs;
      if (frac >= 0 && frac <= 1){
        const angle = Math.PI*(1-frac);
        const sx = cx + r*Math.cos(angle), sy = cy - r*Math.sin(angle);
        const glow = document.createElementNS(ns,'circle');
        glow.setAttribute('cx',sx); glow.setAttribute('cy',sy); glow.setAttribute('r',22);
        glow.setAttribute('fill','#F5A742'); glow.setAttribute('opacity','0.22');
        g.appendChild(glow);
        const sun = document.createElementNS(ns,'circle');
        sun.setAttribute('cx',sx); sun.setAttribute('cy',sy); sun.setAttribute('r',9);
        sun.setAttribute('fill','#FBC978');
        g.appendChild(sun);
      }
    } else {
      const label = document.createElementNS(ns,'text');
      label.setAttribute('x',cx); label.setAttribute('y',cy-40); label.setAttribute('text-anchor','middle');
      label.setAttribute('fill','#B9C4D6'); label.setAttribute('font-size','12'); label.setAttribute('font-family','Inter');
      label.textContent = polar==='night' ? 'Polar night — the sun stays below the horizon' : 'Midnight sun — the sun never sets';
      g.appendChild(label);
    }
    els.arcSvg.appendChild(g);
  }

  function drawYearChart(lat, lon, year, highlightMonth){
    const ns='http://www.w3.org/2000/svg', w=620,h=170,padL=10,padR=10,padT=14,padB=26;
    els.yearSvg.innerHTML='';
    const points = [];
    for (let m=1;m<=12;m++){
      const st = sunTimes(year, m, 15, lat, lon);
      points.push(st.polar==='night' ? 0 : st.polar==='day' ? 24 : st.durationHours);
    }
    const plotW=w-padL-padR, plotH=h-padT-padB;
    const xFor = i => padL + (i/11)*plotW;
    const yFor = v => padT + (1-v/24)*plotH;
    const g = document.createElementNS(ns,'g');

    [6,12,18].forEach(v=>{
      const y = yFor(v);
      const l = document.createElementNS(ns,'line');
      l.setAttribute('x1',padL); l.setAttribute('x2',w-padR); l.setAttribute('y1',y); l.setAttribute('y2',y);
      l.setAttribute('stroke','#ffffff'); l.setAttribute('stroke-opacity','0.06');
      g.appendChild(l);
    });

    let areaD = `M ${xFor(0)} ${yFor(points[0])} `;
    points.forEach((v,i)=>{ if(i>0) areaD += `L ${xFor(i)} ${yFor(v)} `; });
    areaD += `L ${xFor(11)} ${h-padB} L ${xFor(0)} ${h-padB} Z`;
    const area = document.createElementNS(ns,'path');
    area.setAttribute('d',areaD); area.setAttribute('fill','#F5A742'); area.setAttribute('opacity','0.08');
    g.appendChild(area);

    let d='';
    points.forEach((v,i)=>{ d += (i===0?'M':'L') + xFor(i) + ' ' + yFor(v) + ' '; });
    const path = document.createElementNS(ns,'path');
    path.setAttribute('d',d.trim()); path.setAttribute('fill','none');
    path.setAttribute('stroke','#F5A742'); path.setAttribute('stroke-width','2.5');
    g.appendChild(path);

    points.forEach((v,i)=>{
      const x=xFor(i), y=yFor(v);
      const dot = document.createElementNS(ns,'circle');
      dot.setAttribute('cx',x); dot.setAttribute('cy',y); dot.setAttribute('r', i===highlightMonth?5:2.5);
      dot.setAttribute('fill', i===highlightMonth ? '#FBC978' : '#F5A742');
      dot.setAttribute('opacity', i===highlightMonth ? '1':'0.5');
      g.appendChild(dot);
    });

    ['J','F','M','A','M','J','J','A','S','O','N','D'].forEach((lab,i)=>{
      const t = document.createElementNS(ns,'text');
      t.setAttribute('x',xFor(i)); t.setAttribute('y',h-8); t.setAttribute('text-anchor','middle');
      t.setAttribute('font-family','Inter'); t.setAttribute('font-size','10');
      t.setAttribute('fill', i===highlightMonth ? '#EDF1F7':'#8996AA');
      t.textContent = lab;
      g.appendChild(t);
    });
    els.yearSvg.appendChild(g);
  }

  function drawCompass(altitude, azimuth){
    const ns='http://www.w3.org/2000/svg', cx=110, cy=110, R=88;
    els.compassSvg.innerHTML='';
    const g = document.createElementNS(ns,'g');
    [0.33,0.66,1].forEach(f=>{
      const c = document.createElementNS(ns,'circle');
      c.setAttribute('cx',cx); c.setAttribute('cy',cy); c.setAttribute('r',R*f);
      c.setAttribute('fill','none'); c.setAttribute('stroke','#ffffff'); c.setAttribute('stroke-opacity','0.09');
      c.setAttribute('stroke-dasharray', f===1 ? '0':'3 4');
      g.appendChild(c);
    });
    [['N',0],['E',90],['S',180],['W',270]].forEach(([lab,a])=>{
      const arad=(a-90)*rad;
      const x = cx + (R+14)*Math.cos(arad), y = cy + (R+14)*Math.sin(arad);
      const t = document.createElementNS(ns,'text');
      t.setAttribute('x',x); t.setAttribute('y',y+4); t.setAttribute('text-anchor','middle');
      t.setAttribute('font-family','Inter'); t.setAttribute('font-size','11'); t.setAttribute('fill','#8996AA');
      t.textContent = lab;
      g.appendChild(t);
    });
    if (altitude > -2){
      const rNorm = Math.max(0, (90-Math.max(altitude,0))/90) * R;
      const arad = (azimuth-90)*rad;
      const x = cx + rNorm*Math.cos(arad), y = cy + rNorm*Math.sin(arad);
      const glow = document.createElementNS(ns,'circle');
      glow.setAttribute('cx',x); glow.setAttribute('cy',y); glow.setAttribute('r',14);
      glow.setAttribute('fill','#F5A742'); glow.setAttribute('opacity','0.25');
      g.appendChild(glow);
      const dot = document.createElementNS(ns,'circle');
      dot.setAttribute('cx',x); dot.setAttribute('cy',y); dot.setAttribute('r',7);
      dot.setAttribute('fill','#FBC978');
      g.appendChild(dot);
    } else {
      const t = document.createElementNS(ns,'text');
      t.setAttribute('x',cx); t.setAttribute('y',cy+4); t.setAttribute('text-anchor','middle');
      t.setAttribute('font-family','Inter'); t.setAttribute('font-size','10'); t.setAttribute('fill','#8996AA');
      t.textContent='Below horizon';
      g.appendChild(t);
    }
    const centerDot = document.createElementNS(ns,'circle');
    centerDot.setAttribute('cx',cx); centerDot.setAttribute('cy',cy); centerDot.setAttribute('r',2);
    centerDot.setAttribute('fill','#8996AA');
    g.appendChild(centerDot);
    els.compassSvg.appendChild(g);
  }

  const MARKERS_MD = [[3,20,'the March equinox'],[6,21,'the June solstice'],[9,22,'the September equinox'],[12,21,'the December solstice']];
  function nextMarker(now){
    const y = now.getUTCFullYear();
    for (const [m,d,label] of MARKERS_MD){
      const dt = new Date(Date.UTC(y,m-1,d));
      if (dt > now) return {label, days: Math.ceil((dt-now)/86400000)};
    }
    const dt = new Date(Date.UTC(y+1,2,20));
    return {label:'the March equinox', days: Math.ceil((dt-now)/86400000)};
  }

  function updateGreeting(){
    const now = new Date(new Date().getTime() + tzOffsetHours(current.lon)*3600000);
    const h = now.getUTCHours();
    const g = h < 12 ? 'Good morning ☀' : h < 17 ? 'Good afternoon ☀' : 'Good evening 🌙';
    els.greeting.textContent = g;
  }

  function render(){
    const dateVal = els.dateInput.value;
    const [y,m,d] = dateVal.split('-').map(Number);
    const st = sunTimes(y,m,d,current.lat,current.lon);

    els.placeName.textContent = current.name;
    els.placeCoords.textContent = `${current.lat.toFixed(2)}°, ${current.lon.toFixed(2)}°`;
    updateGreeting();

    if (st.polar === 'night' || st.polar === 'day'){
      els.durationNum.textContent = st.polar==='night' ? '0h 00m' : '24h 00m';
      els.sunriseTime.textContent = '—'; els.sunsetTime.textContent = '—';
      els.noonTime.textContent = fmtLocalTime(st.transit, current.lon);
      els.durationDelta.textContent = st.polar==='night' ? 'Polar night' : 'Midnight sun';
      els.durationDelta.className = 'tile-delta delta-flat';
      drawArc(null,null, st.polar);
      els.insightBox.innerHTML = st.polar==='night'
        ? 'The sun does not rise here today — this location is in <b>polar night</b>.'
        : 'The sun does not set here today — this location is experiencing the <b>midnight sun</b>.';
    } else {
      els.durationNum.textContent = fmtDuration(st.durationHours);
      els.sunriseTime.textContent = fmtLocalTime(st.sunrise, current.lon);
      els.sunsetTime.textContent = fmtLocalTime(st.sunset, current.lon);
      els.noonTime.textContent = fmtLocalTime(st.transit, current.lon);

      const prev = new Date(Date.UTC(y,m-1,d)); prev.setUTCDate(prev.getUTCDate()-1);
      const stPrev = sunTimes(prev.getUTCFullYear(), prev.getUTCMonth()+1, prev.getUTCDate(), current.lat, current.lon);
      let diffMin = 0;
      if (typeof stPrev.durationHours === 'number') diffMin = Math.round((st.durationHours - stPrev.durationHours)*60);
      if (diffMin > 0){ els.durationDelta.textContent = `↑ +${diffMin} min vs yesterday`; els.durationDelta.className='tile-delta delta-up'; }
      else if (diffMin < 0){ els.durationDelta.textContent = `↓ ${diffMin} min vs yesterday`; els.durationDelta.className='tile-delta delta-down'; }
      else { els.durationDelta.textContent = 'Same as yesterday'; els.durationDelta.className='tile-delta delta-flat'; }

      drawArc(st.sunrise, st.sunset, null);

      const marker = nextMarker(new Date(Date.UTC(y,m-1,d,12)));
      const trend = diffMin > 0 ? 'growing' : diffMin < 0 ? 'shrinking' : 'holding steady';
      els.insightBox.innerHTML = `Daylight here is <b>${trend}</b> — about ${Math.abs(diffMin)} min ${diffMin>=0?'longer':'shorter'} than yesterday. At this rate, expect the trend to continue until around <b>${marker.label}</b>, roughly ${marker.days} days away.`;
    }
    drawYearChart(current.lat, current.lon, y, m-1);
  }

  function updateLive(){
    const now = new Date();
    const pos = solarPosition(now, current.lat, current.lon);
    const altTxt = pos.altitude.toFixed(1) + '°';
    const azTxt = pos.azimuth.toFixed(0) + '°';
    els.chipAlt.textContent = altTxt; els.chipAz.textContent = azTxt;
    els.compAlt.textContent = altTxt; els.compAz.textContent = azTxt;
    drawCompass(pos.altitude, pos.azimuth);
    const hh = String(now.getHours()).padStart(2,'0'), mm = String(now.getMinutes()).padStart(2,'0');
    els.updatedAt.textContent = 'Updated ' + hh + ':' + mm;
  }

  function setToday(){
    const now = new Date();
    els.dateInput.value = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0');
  }

  function setCity(name, lat, lon){
    current = { name, lat, lon };
    els.cityInput.value=''; els.suggestions.hidden = true;
    try { localStorage.setItem('daylight_last_place', JSON.stringify(current)); } catch(e){}
    render(); updateLive();
  }

  function showSuggestions(query){
    const q = query.trim().toLowerCase();
    if (!q){ els.suggestions.hidden = true; return; }
    const matches = CITIES.filter(c => c[0].toLowerCase().includes(q)).slice(0,8);
    if (!matches.length){ els.suggestions.hidden = true; return; }
    els.suggestions.innerHTML = '';
    matches.forEach(([name,lat,lon])=>{
      const btn = document.createElement('button'); btn.type='button'; btn.textContent = name;
      btn.addEventListener('click', ()=> setCity(name,lat,lon));
      els.suggestions.appendChild(btn);
    });
    els.suggestions.hidden = false;
  }

  els.cityInput.addEventListener('input', e => showSuggestions(e.target.value));
  els.cityInput.addEventListener('blur', ()=> setTimeout(()=>{ els.suggestions.hidden = true; },150));
  els.cityInput.addEventListener('keydown', e=>{
    if (e.key==='Enter'){
      const q = e.target.value.trim().toLowerCase();
      const match = CITIES.find(c => c[0].toLowerCase().includes(q));
      if (match) setCity(match[0], match[1], match[2]);
    }
  });
  els.locateBtn.addEventListener('click', ()=>{
    if (!navigator.geolocation) return;
    els.locateBtn.textContent='…';
    navigator.geolocation.getCurrentPosition(
      pos => { els.locateBtn.textContent='⌖'; setCity('Your location', pos.coords.latitude, pos.coords.longitude); },
      () => { els.locateBtn.textContent='⌖'; },
      { timeout: 8000 }
    );
  });
  els.dateInput.addEventListener('change', render);
  els.todayBtn.addEventListener('click', ()=>{ setToday(); render(); });

  try {
    const saved = JSON.parse(localStorage.getItem('daylight_last_place') || 'null');
    if (saved && typeof saved.lat === 'number') current = saved;
  } catch(e){}

  setToday();
  render();
  updateLive();
  setInterval(updateLive, 30000);
})();
</script>
</body>
</html>
