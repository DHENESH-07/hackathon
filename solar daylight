    ["Lagos, Nigeria",6.5244,3.3792],["Nairobi, Kenya",-1.2921,36.8219],["Cape Town, South Africa",-33.9249,18.4241],
    ["Johannesburg, South Africa",-26.2041,28.0473],["Dubai, UAE",25.2048,55.2708],["Tel Aviv, Israel",32.0853,34.7818],
    ["Riyadh, Saudi Arabia",24.7136,46.6753],["Tokyo, Japan",35.6762,139.6503],["Osaka, Japan",34.6937,135.5023],
    ["Seoul, South Korea",37.5665,126.9780],["Beijing, China",39.9042,116.4074],["Shanghai, China",31.2304,121.4737],
    ["Hong Kong",22.3193,114.1694],["Singapore",1.3521,103.8198],["Bangkok, Thailand",13.7563,100.5018],
