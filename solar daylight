<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Daylight — SolarQuest</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070C16;
    --panel:#101B2E;
    --panel-2:#0C1526;
    --line:rgba(255,255,255,.07);
    --text:#EDF1F7;
    --text-dim:#8996AA;
    --gold:#F5A742;
    --gold-soft:#FBC978;
    --blue:#4C8DFF;
    --purple:#A78BFA;
    --green:#34D399;
    --red:#F17171;
    font-size:16px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1100px 500px at 15% -10%, #12213B 0%, transparent 60%),
      radial-gradient(900px 500px at 100% 0%, #16233d80 0%, transparent 55%),
      var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    padding:1.5rem 1.5rem 3.5rem;
  }
  .wrap{max-width:1180px;margin:0 auto;}

  .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.4rem;flex-wrap:wrap;gap:.75rem;}
  .brand{display:flex;align-items:center;gap:.65rem;}
  .brand-mark{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--gold),#D9861F);
    display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px #F5A74240;}
  .brand-name{font-weight:700;font-size:1rem;letter-spacing:-.01em;}
  .brand-page{color:var(--text-dim);font-size:.78rem;margin-top:1px;}
  .status{display:flex;align-items:center;gap:1rem;font-size:.78rem;color:var(--text-dim);}
  .live{display:flex;align-items:center;gap:.4rem;color:var(--green);font-weight:600;}
  .live .dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite;}
  @media (prefers-reduced-motion:reduce){.live .dot{animation:none;}}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(52,211,153,.55);}70%{box-shadow:0 0 0 7px rgba(52,211,153,0);}100%{box-shadow:0 0 0 0 rgba(52,211,153,0);}}

  .hero{position:relative;border-radius:22px;overflow:hidden;border:1px solid var(--line);
    background:radial-gradient(500px 260px at 78% 15%, #2A466F55 0%, transparent 70%),
      linear-gradient(180deg,#132443 0%, #0C1730 55%, #081020 100%);
    padding:1.9rem 1.9rem 2.2rem;margin-bottom:1.1rem;}
  .hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;}
  .hero h1{font-size:1.5rem;font-weight:700;margin:0 0 .3rem;letter-spacing:-.01em;}
  .hero .sub{color:#B9C4D6;font-size:.88rem;margin:0;max-width:34ch;}

  .sun-chip{background:#0B172ACC;border:1px solid var(--line);border-radius:12px;padding:.65rem .9rem;
    font-size:.76rem;color:var(--text-dim);min-width:150px;}
  .sun-chip .row{display:flex;justify-content:space-between;color:var(--text);font-weight:600;margin-top:.15rem;font-size:.85rem;}
  .sun-chip .row + .row{margin-top:.35rem;}

  .arc-stage{position:relative;height:150px;margin-top:1rem;}
  .arc-stage svg{width:100%;height:100%;display:block;}

  .loc-row{display:flex;align-items:center;gap:.9rem;flex-wrap:wrap;margin-top:.6rem;}
  .loc-current{display:flex;align-items:center;gap:.6rem;color:#CBD5E6;font-size:.85rem;}
  .loc-current b{color:var(--text);font-weight:600;}

  .search-row{display:flex;gap:.5rem;margin-top:.9rem;position:relative;max-width:420px;}
  .search-box{position:relative;flex:1;}
  input[type="text"]{width:100%;background:#0B172AB0;border:1px solid var(--line);color:var(--text);
    font-family:'Inter',sans-serif;font-size:.88rem;padding:.7rem .95rem;border-radius:10px;outline:none;}
  input[type="text"]::placeholder{color:var(--text-dim);}
  input[type="text"]:focus{border-color:var(--gold);box-shadow:0 0 0 3px #F5A74226;}
  .suggestions{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#101B2E;border:1px solid var(--line);
    border-radius:10px;overflow:hidden;z-index:20;max-height:240px;overflow-y:auto;box-shadow:0 16px 34px #00000060;}
  .suggestions button{display:block;width:100%;text-align:left;background:none;border:none;color:var(--text);
    font-family:'Inter',sans-serif;font-size:.85rem;padding:.6rem .9rem;cursor:pointer;}
  .suggestions button:hover,.suggestions button:focus-visible{background:#F5A74220;}
  .locate-btn{background:#0B172AB0;border:1px solid var(--line);color:var(--text);border-radius:10px;
    padding:0 .95rem;cursor:pointer;font-size:1rem;}
  .locate-btn:hover{border-color:var(--gold);color:var(--gold-soft);}
  button:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}

  .tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.1rem;}
  @media (max-width:820px){.tiles{grid-template-columns:repeat(2,1fr);}}
  .tile{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:1.1rem 1.15rem;}
  .tile-top{display:flex;align-items:center;gap:.6rem;margin-bottom:.7rem;}
  .icon-badge{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .tile-label{color:var(--text-dim);font-size:.78rem;}
  .tile-num{font-size:1.5rem;font-weight:700;letter-spacing:-.01em;font-variant-numeric:tabular-nums;}
  .tile-delta{display:inline-flex;align-items:center;gap:.25rem;font-size:.72rem;font-weight:600;margin-top:.4rem;padding:.15rem .5rem;border-radius:20px;}
  .delta-up{background:#34D39922;color:var(--green);}
  .delta-down{background:#F1717122;color:var(--red);}
  .delta-flat{background:#8996AA22;color:var(--text-dim);}

  .grid2{display:grid;grid-template-columns:1.5fr 1fr;gap:1.1rem;}
  @media (max-width:900px){.grid2{grid-template-columns:1fr;}}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:1.4rem 1.5rem;}
  .panel h2{font-size:.85rem;font-weight:600;margin:0 0 .2rem;}
  .panel .desc{color:var(--text-dim);font-size:.76rem;margin:0 0 1rem;}
  .panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:.6rem;flex-wrap:wrap;margin-bottom:.6rem;}
  .date-controls{display:flex;align-items:center;gap:.5rem;}
  input[type="date"]{background:var(--panel-2);border:1px solid var(--line);color:var(--text);font-family:'Inter',sans-serif;
    padding:.4rem .6rem;border-radius:8px;font-size:.78rem;color-scheme:dark;}
  .today-btn{background:none;border:1px solid var(--line);color:var(--text-dim);border-radius:8px;padding:.4rem .7rem;
    font-size:.75rem;cursor:pointer;font-family:'Inter',sans-serif;}
  .today-btn:hover{color:var(--text);border-color:var(--gold);}

  .year-chart{width:100%;height:auto;display:block;}

  .compass-wrap{display:flex;justify-content:center;margin:.4rem 0 .6rem;}
  .compass-wrap svg{width:100%;max-width:220px;height:auto;}
  .compass-readout{display:flex;justify-content:space-around;text-align:center;margin-top:.4rem;}
  .compass-readout div .v{font-weight:700;font-size:1rem;}
  .compass-readout div .l{color:var(--text-dim);font-size:.7rem;margin-top:.1rem;}

  .insight{margin-top:1.1rem;background:linear-gradient(135deg,#152B1F,#0F1E2E);
    border:1px solid #34D39930;border-radius:16px;padding:1.1rem 1.2rem;
    font-size:.84rem;color:#D6E4DD;line-height:1.5;}
  .insight b{color:var(--gold-soft);}

  .note{color:var(--text-dim);font-size:.7rem;margin-top:1.3rem;line-height:1.5;text-align:center;}
</style>
</head>
<body>
<div class="wrap">

  <div class="topbar">
    <div class="brand">
      <div class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.5" fill="#0B1220"/><g stroke="#0B1220" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1.5" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22.5"/><line x1="1.5" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22.5" y2="12"/><line x1="4.4" y1="4.4" x2="6.1" y2="6.1"/><line x1="17.9" y1="17.9" x2="19.6" y2="19.6"/><line x1="4.4" y1="19.6" x2="6.1" y2="17.9"/><line x1="17.9" y1="6.1" x2="19.6" y2="4.4"/></g></svg>
      </div>
      <div>
        <div class="brand-name">SolarQuest</div>
        <div class="brand-page">Daylight &amp; sun position</div>
      </div>
    </div>
    <div class="status">
      <span class="live"><span class="dot"></span>Live</span>
      <span id="updatedAt">Updated —</span>
    </div>
  </div>

  <div class="hero">
    <div class="hero-top">
      <div>
        <h1 id="greeting">Good day ☀</h1>
        <p class="sub">Here's how much sunlight this location gets, and where the sun sits right now.</p>
      </div>
      <div class="sun-chip">
        <div style="color:var(--text-dim);font-size:.72rem;">Sun position now</div>
        <div class="row"><span style="color:var(--text-dim);font-weight:400;">Altitude</span><span id="chipAlt">–</span></div>
        <div class="row"><span style="color:var(--text-dim);font-weight:400;">Azimuth</span><span id="chipAz">–</span></div>
      </div>
    </div>

    <div class="arc-stage"><svg id="arcSvg" viewBox="0 0 900 150" preserveAspectRatio="xMidYMid meet"></svg></div>

    <div class="loc-row">
      <div class="loc-current">
        <span>📍</span><span><b id="placeName">Chennai, India</b> · <span id="placeCoords">13.08°, 80.27°</span></span>
      </div>
    </div>
    <div class="search-row">
      <div class="search-box">
        <input type="text" id="cityInput" placeholder="Search a city…" autocomplete="off" aria-label="Search for a city">
        <div class="suggestions" id="suggestions" hidden></div>
      </div>
      <button class="locate-btn" id="locateBtn" title="Use my location" aria-label="Use my location">⌖</button>
    </div>
  </div>

  <div class="tiles">
    <div class="tile">
      <div class="tile-top">
        <div class="icon-badge" style="background:#F5A74222;color:var(--gold);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><line x1="12" y1="1.5" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22.5"/><line x1="1.5" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22.5" y2="12"/></svg>
        </div>
        <span class="tile-label">Daylight duration</span>
      </div>
      <div class="tile-num" id="durationNum">–</div>
      <div class="tile-delta delta-flat" id="durationDelta">–</div>
    </div>

    <div class="tile">
      <div class="tile-top">
        <div class="icon-badge" style="background:#4C8DFF22;color:var(--blue);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0"/><line x1="12" y1="9" x2="12" y2="2"/><line x1="4.2" y1="10.2" x2="5.6" y2="11.6"/><line x1="1" y1="18" x2="3" y2="18"/><line x1="21" y1="18" x2="23" y2="18"/><line x1="18.4" y1="11.6" x2="19.8" y2="10.2"/><polyline points="9 18 21 18"/></svg>
        </div>
        <span class="tile-label">Sunrise</span>
      </div>
      <div class="tile-num" id="sunriseTime">–</div>
      <div class="tile-delta delta-flat">Local time</div>
    </div>

    <div class="tile">
      <div class="tile-top">
        <div class="icon-badge" style="background:#FBC97822;color:var(--gold-soft);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <span class="tile-label">Solar noon</span>
      </div>
      <div class="tile-num" id="noonTime">–</div>
      <div class="tile-delta delta-flat">Sun at its highest</div>
    </div>

    <div class="tile">
      <div class="tile-top">
        <div class="icon-badge" style="background:#A78BFA22;color:var(--purple);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0"/><line x1="12" y1="9" x2="12" y2="2"/><line x1="4.2" y1="10.2" x2="5.6" y2="11.6"/><line x1="1" y1="18" x2="3" y2="18"/><line x1="21" y1="18" x2="23" y2="18"/><line x1="18.4" y1="11.6" x2="19.8" y2="10.2"/><polyline points="21 18 9 18"/></svg>
        </div>
        <span class="tile-label">Sunset</span>
      </div>
      <div class="tile-num" id="sunsetTime">–</div>
      <div class="tile-delta delta-flat">Local time</div>
    </div>
  </div>

  <div class="grid2">
    <div class="panel">
      <div class="panel-head">
        <div>
          <h2>Daylight across the year</h2>
          <p class="desc">Hours of sunlight by month for this location</p>
        </div>
        <div class="date-controls">
          <input type="date" id="dateInput">
          <button class="today-btn" id="todayBtn">Today</button>
        </div>
      </div>
      <svg id="yearSvg" class="year-chart" viewBox="0 0 620 170" preserveAspectRatio="xMidYMid meet"></svg>

      <div class="insight" id="insightBox">Calculating…</div>
    </div>

    <div class="panel">
      <h2>Sun position</h2>
      <p class="desc">Altitude and direction, right now</p>
      <div class="compass-wrap"><svg id="compassSvg" viewBox="0 0 220 220"></svg></div>
      <div class="compass-readout">
        <div><div class="v" id="compAlt">–</div><div class="l">altitude</div></div>
        <div><div class="v" id="compAz">–</div><div class="l">azimuth</div></div>
      </div>
    </div>
  </div>

  <div class="note">Sun position and daylight hours are computed directly from solar geometry for the coordinates shown. Clock times are approximate, based on the location's longitude.</div>
</div>

<script>
(function(){
  const CITIES = [
