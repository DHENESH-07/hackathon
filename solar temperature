        );

    border:
        1px solid rgba(255,255,255,0.10);

}


.hero::after {

    content: "🌡️";

    position: absolute;

    right: 9%;

    top: 35px;

    font-size: 100px;

    opacity: 0.15;

}


.hero h2 {

    font-size: 28px;

    margin-bottom: 8px;

}

.hero h2 span {

    color: #ffbe3d;

}


.hero p {

    color: #9eb1c5;

    margin-bottom: 20px;

}


.location {

    color: #aebfd0;

    font-size: 13px;

}


.location strong {

    color: white;

}


/* ===============================
   BUTTONS
================================ */

.buttons {

    display: flex;

    gap: 10px;

    margin-top: 20px;

}


button {

    border: none;

    cursor: pointer;

    padding:
