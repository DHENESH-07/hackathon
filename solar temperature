    font-weight: bold;

    color: #ffbd3d;

}


.condition {

    font-size: 17px;

    color: #a9bacb;

    margin-top: 5px;

}


.feels {

    margin-top: 15px;

    color: #8da2b6;

    font-size: 14px;

}


.feels strong {

    color: white;

}


/* ===============================
   WEATHER INFORMATION
================================ */

.info-grid {

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 12px;

    margin-top: 15px;

}


.info-card {

    background:
        linear-gradient(
            145deg,
            rgba(15,58,88,0.70),
            rgba(4,27,49,0.90)
        );

    border:
        1px solid rgba(100,180,230,0.15);

    border-radius: 14px;

    padding: 20px;

}


.info-top {

    display: flex;

    align-items: center;

    gap: 10px;

    color: #9db1c4;

    font-size: 13px;

}


.info-icon {

    width: 40px;

    height: 40px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        rgba(255,190,50,0.10);

    font-size: 20px;

}


.info-value {

    font-size: 24px;

    font-weight: bold;

    margin-top: 13px;

}


.info-description {

    color: #71869a;

    font-size: 10px;

    margin-top: 5px;

}


/* ===============================
   LOCATION CARD
================================ */

.location-card {

    margin-top: 15px;

    padding: 20px;

    border-radius: 15px;

    background:
        rgba(4,27,49,0.75);

    border:
        1px solid rgba(100,180,230,0.15);

}


.location-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 10px;

    margin-top: 15px;

}


.location-box {

    background:
        rgba(0,0,0,0.18);

    border-radius: 9px;

    padding: 15px;

}


.location-box small {

    color: #71879c;

}


.location-box strong {

    display: block;

    margin-top: 5px;

}


/* ===============================
   FOOTER
================================ */

.footer {

    text-align: center;

    margin-top: 30px;

    color: #60788e;

    font-size: 11px;

}


/* ===============================
   RESPONSIVE
================================ */

@media(max-width:1000px) {

    .sidebar {

        width: 70px;

    }

    .sidebar .logo h1,
    .sidebar .logo small,
    .menu-item span:not(.menu-icon),
    .menu-title,
    .profile div {

        display: none;

    }

    .main {

        margin-left: 70px;

    }

    .info-grid {

        grid-template-columns:
            repeat(2,1fr);

    }

}


@media(max-width:600px) {

    .main {

        padding: 12px;

    }

    .hero h2 {

        font-size: 21px;

    }

    .info-grid,
    .location-grid {

        grid-template-columns: 1fr;

    }

    .temperature {

        font-size: 55px;

    }

    .search {

        flex-direction: column;

    }

    .search input {

        width: 100%;

    }

}


/* LOADING */

.loading {

    opacity: 0.5;

}

</style>
