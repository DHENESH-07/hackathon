<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SolarQuest - Temperature</title>

<style>

/* ===============================
   BASIC RESET
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
    color: white;

    background:
        radial-gradient(
            circle at 75% 10%,
            rgba(255, 180, 50, 0.12),
            transparent 25%
        ),
        radial-gradient(
            circle at 10% 90%,
            rgba(0, 130, 255, 0.15),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #020b18,
            #061b32 50%,
            #03101f
        );
}


/* ===============================
   SIDEBAR
================================ */

.sidebar {

    position: fixed;

    left: 0;
    top: 0;

    width: 225px;
    height: 100vh;

    background: rgba(2, 12, 27, 0.94);

    border-right:
        1px solid rgba(255,255,255,0.08);

    padding: 22px 15px;

}


/* LOGO */

.logo {

    display: flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 30px;

}

.logo-icon {

    font-size: 34px;

}

.logo h1 {

    font-size: 20px;

}

.logo h1 span {

    color: #ffbd3d;

}

.logo small {

    display: block;

    font-size: 8px;

    color: #8ea0b4;

    margin-top: 3px;

}


/* MENU */

.menu-title {

    color: #65778b;

    font-size: 11px;

    margin:
        18px 10px 8px;

    text-transform: uppercase;

}


.menu-item {

    display: flex;

    align-items: center;

    gap: 13px;

    padding: 12px;

    margin-bottom: 4px;

    border-radius: 9px;

    color: #b7c4d2;

    cursor: pointer;

    transition: 0.2s;

}


.menu-item:hover {

    background:
        rgba(0,120,255,0.18);

    color: white;

}


.menu-item.active {

    background:
        linear-gradient(
            90deg,
            rgba(0,128,255,0.35),
            rgba(0,128,255,0.10)
        );

    color: white;

}


.menu-icon {

    width: 20px;

    text-align: center;

}


/* PROFILE */

.profile {

    position: absolute;

    bottom: 20px;

    left: 15px;

    right: 15px;

    padding-top: 15px;

    border-top:
        1px solid rgba(255,255,255,0.08);

    display: flex;

    align-items: center;

    gap: 10px;

}

.profile-circle {

    width: 35px;

    height: 35px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #8b9caf,
            #26394e
        );

    display: flex;

    justify-content: center;

    align-items: center;

}


/* ===============================
   MAIN
================================ */

.main {

    margin-left: 225px;

    padding: 25px;

    max-width: 1500px;

}


/* ===============================
   TOP BAR
================================ */

.topbar {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 20px;

}

.live {

    display: flex;

    align-items: center;

    gap: 7px;

    padding: 7px 12px;

    border-radius: 20px;

    background:
        rgba(0,255,180,0.08);

    border:
        1px solid rgba(0,255,180,0.15);

    font-size: 12px;

}

.live-dot {

    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #00e6a8;

    box-shadow:
        0 0 10px #00e6a8;

}


/* ===============================
   HERO
================================ */

.hero {

    position: relative;

    overflow: hidden;

    min-height: 220px;

    padding: 30px;

    border-radius: 20px;

    background:
        linear-gradient(
            100deg,
            rgba(3,17,35,0.98),
