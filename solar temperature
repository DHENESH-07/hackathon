<script>

/* =================================================
   GLOBAL VARIABLES
================================================= */

let currentLat = null;
let currentLon = null;


/* =================================================
   WEATHER DESCRIPTION
================================================= */

function getWeatherDescription(code) {

    if (code === 0)
        return "Clear Sky";

    if (code === 1)
        return "Mainly Clear";

    if (code === 2)
        return "Partly Cloudy";

    if (code === 3)
        return "Overcast";

    if (code === 45 || code === 48)
        return "Foggy";

    if (code >= 51 && code <= 57)
        return "Drizzle";

    if (code >= 61 && code <= 67)
        return "Rain";

    if (code >= 71 && code <= 77)
        return "Snow";

    if (code >= 80 && code <= 82)
        return "Rain Showers";

    if (code >= 95)
        return "Thunderstorm";

    return "Unknown";

}


/* =================================================
   WEATHER ICON
================================================= */

function getWeatherIcon(code) {

    if (code === 0)
        return "☀️";

    if (code === 1)
        return "🌤️";

    if (code === 2)
        return "⛅";

    if (code === 3)
        return "☁️";

    if (code >= 45 && code <= 48)
        return "🌫️";

    if (code >= 51 && code <= 67)
        return "🌧️";

    if (code >= 71 && code <= 77)
        return "❄️";

    if (code >= 80 && code <= 82)
        return "🌦️";

    if (code >= 95)
        return "⛈️";

    return "🌤️";

}


/* =================================================
   GET TEMPERATURE DATA
================================================= */

async function getTemperatureData(
    lat,
    lon,
    locationName
) {

    try {

        document.getElementById(
            "locationName"
        ).textContent =
            locationName;


        document.getElementById(
            "condition"
        ).textContent =
            "Loading temperature data...";


        /*
            Open-Meteo API

            current:
            temperature
            apparent temperature
            humidity
            wind
            weather code

            daily:
            maximum temperature
            minimum temperature
        */

        const url =
            `https://api.open-meteo.com/v1/forecast?` +
            `latitude=${lat}` +
            `&longitude=${lon}` +
            `&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code` +
            `&daily=temperature_2m_max,temperature_2m_min` +
            `&timezone=auto`;


        const response =
            await fetch(url);


        if (!response.ok) {

            throw new Error(
                "Temperature data unavailable"
            );

        }


        const data =
            await response.json();


        currentLat = lat;

        currentLon = lon;


        /* ==========================
           CURRENT TEMPERATURE
        ========================== */

        const current =
            data.current;


        document.getElementById(
            "temperature"
        ).textContent =
            Math.round(
                current.temperature_2m
            ) + "°C";


        /* FEELS LIKE */

        document.getElementById(
            "feelsLike"
        ).textContent =
            Math.round(
                current.apparent_temperature
            ) + "°C";


        /* CONDITION */

        document.getElementById(
            "condition"
        ).textContent =
            getWeatherDescription(
                current.weather_code
            );


        /* ICON */

        document.getElementById(
            "weatherIcon"
        ).textContent =
            getWeatherIcon(
                current.weather_code
            );


        /* ==========================
           MAX / MIN
        ========================== */

        document.getElementById(
            "maxTemp"
        ).textContent =
            Math.round(
                data.daily.temperature_2m_max[0]
            ) + "°C";


        document.getElementById(
            "minTemp"
        ).textContent =
            Math.round(
                data.daily.temperature_2m_min[0]
            ) + "°C";


        /* ==========================
           HUMIDITY
        ========================== */

        document.getElementById(
            "humidity"
        ).textContent =
            current.relative_humidity_2m
            + "%";


        /* ==========================
           WIND
        ========================== */

        document.getElementById(
            "wind"
        ).textContent =
            Math.round(
                current.wind_speed_10m
            )
            + " km/h";


        /* ==========================
           LOCATION
        ========================== */

        document.getElementById(
            "latitude"
        ).textContent =
            Number(lat).toFixed(4)
            + "°";


        document.getElementById(
            "longitude"
        ).textContent =
            Number(lon).toFixed(4)
            + "°";


        document.getElementById(
            "timezone"
        ).textContent =
            data.timezone;


    }

    catch(error) {

        console.error(error);

        document.getElementById(
            "condition"
        ).textContent =
            "Unable to load temperature data.";

        alert(
            "Could not load temperature data. Please try again."
        );

    }

}


/* =================================================
   USE MY LOCATION
================================================= */

function useMyLocation() {

    if (!navigator.geolocation) {

        alert(
            "Geolocation is not supported by your browser."
        );

        return;

    }


    document.getElementById(
        "locationName"
    ).textContent =
        "Finding your location...";


    navigator.geolocation.getCurrentPosition(

        async function(position) {

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;


            /*
                Reverse geocoding

                Converts coordinates
                into a city name.
            */

            try {

                const response =
                    await fetch(
                        `https://geocoding-api.open-meteo.com/v1/reverse?latitude=${lat}&longitude=${lon}&count=1&language=en&format=json`
                    );


                const data =
                    await response.json();


                let locationName =
                    "Your Location";


                if (
                    data.results &&
                    data.results.length > 0
                ) {

                    const place =
                        data.results[0];


                    locationName =
                        place.name;


                    if (place.country) {

                        locationName +=
                            ", " +
                            place.country;

                    }

                }


                await getTemperatureData(
                    lat,
                    lon,
                    locationName
                );


            }

            catch(error) {

                await getTemperatureData(
                    lat,
                    lon,
                    "Your Location"
                );

            }

        },


        function(error) {

            console.error(error);

            alert(
                "Location access was denied.\n\n" +
                "Please allow location permission and try again."
            );

        },


        {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 300000
        }

    );

}


/* =================================================
   SEARCH CITY
================================================= */

async function searchPlace() {

    const query =
        document
        .getElementById("placeInput")
        .value
        .trim();


    if (!query) {

        alert(
            "Please enter a city name."
        );

        return;

    }


    try {

        document.getElementById(
            "locationName"
        ).textContent =
            "Searching...";


        const response =
            await fetch(
                `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=en&format=json`
            );


        const data =
            await response.json();


        if (
            !data.results ||
            data.results.length === 0
        ) {

            throw new Error(
                "Location not found"
            );

        }


        const place =
            data.results[0];


        let locationName =
            place.name;


        if (place.country) {

            locationName +=
                ", " +
                place.country;

        }


        await getTemperatureData(
            place.latitude,
            place.longitude,
            locationName
        );


    }

    catch(error) {

        alert(
            "Location not found. Try another city."
        );

    }

}


/* =================================================
   REFRESH
================================================= */

function refreshData() {

    if (
        currentLat !== null &&
        currentLon !== null
    ) {

        getTemperatureData(
            currentLat,
            currentLon,
            document
                .getElementById(
                    "locationName"
                )
                .textContent
        );

    }

    else {

        useMyLocation();

    }

}


/* =================================================
   ENTER KEY
================================================= */

document
.getElementById("placeInput")
.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {

            searchPlace();

        }

    }
);

</script>

