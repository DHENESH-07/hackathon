}


/* LOGO */

.logo {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 30px;

}

.logo-icon {

    font-size: 34px;

}

.logo h1 {

    font-size: 20px;

}

.logo h1 span {

    color: #ffbd3d;

}

.logo small {

    display: block;

    font-size: 8px;

    color: #8ea0b4;

