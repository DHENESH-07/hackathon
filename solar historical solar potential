    align-items: center;

    gap: 10px;

}

.profile-circle {

    width: 35px;

    height: 35px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #8b9caf,
            #26394e
        );

    display: flex;

    align-items: center;

    justify-content: center;

}


/* =====================================================
   MAIN
===================================================== */

.main {

    margin-left: 225px;

    padding: 25px;

    max-width: 1500px;

}


/* =====================================================
   TOP BAR
===================================================== */

.topbar {

    display: flex;

