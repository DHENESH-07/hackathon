}


/* MENU */

.menu-title {

    color: #65778b;

    font-size: 11px;

    margin:
        18px 10px 8px;

    text-transform: uppercase;

}


.menu-item {

    display: flex;

    align-items: center;

    gap: 13px;

    padding: 12px;

    margin-bottom: 4px;

    border-radius: 9px;

    color: #b7c4d2;

    cursor: pointer;

    transition: 0.2s;

}


.menu-item:hover {

    background:
