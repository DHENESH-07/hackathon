    border-radius: 20px;

    background:
        rgba(0,255,180,0.08);

    border:
        1px solid rgba(0,255,180,0.15);

    font-size: 12px;

}


.live-dot {

    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #00e6a8;

    box-shadow:
        0 0 10px #00e6a8;

}


/* =====================================================
   HERO
===================================================== */

.hero {

    position: relative;

    overflow: hidden;

    min-height: 220px;

    padding: 30px;

    border-radius: 20px;

    background:
        linear-gradient(
            100deg,
            rgba(3,17,35,0.98),
            rgba(5,43,68,0.82),
            rgba(5,40,65,0.35)
        );

    border:
