    color: white;

}


.menu-icon {

    width: 20px;

    text-align: center;

}


/* PROFILE */

.profile {

    position: absolute;

    bottom: 20px;

    left: 15px;

    right: 15px;

    padding-top: 15px;

    border-top:
        1px solid rgba(255,255,255,0.08);

