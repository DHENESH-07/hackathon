<script>

/* =====================================================
   GLOBAL VARIABLES
===================================================== */

let currentLat = null;
let currentLon = null;

let solarChart = null;


/* =====================================================
   DATE FORMAT
===================================================== */

function formatDate(date) {

    return date.toISOString()
        .split("T")[0];

}


/* =====================================================
   USE MY LOCATION
===================================================== */

function useMyLocation() {

    if (!navigator.geolocation) {

        alert(
            "Geolocation is not supported by your browser."
        );

        return;

    }


    document.getElementById(
        "locationName"
    ).textContent =
        "Finding your location...";


    navigator.geolocation.getCurrentPosition(

        async function(position) {

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;


            try {

                /*
                    Reverse geocoding
                */

                const response =
                    await fetch(
                        `https://geocoding-api.open-meteo.com/v1/reverse?latitude=${lat}&longitude=${lon}&count=1&language=en&format=json`
                    );


                const data =
                    await response.json();


                let locationName =
                    "Your Location";


                if (
                    data.results &&
                    data.results.length > 0
                ) {

                    const place =
                        data.results[0];


                    locationName =
                        place.name;


                    if (place.country) {

                        locationName +=
                            ", " +
                            place.country;

                    }

                }


                currentLat = lat;
                currentLon = lon;


                document.getElementById(
                    "locationName"
                ).textContent =
                    locationName;


                document.getElementById(
                    "latitude"
                ).textContent =
                    lat.toFixed(4) + "°";


                document.getElementById(
                    "longitude"
                ).textContent =
                    lon.toFixed(4) + "°";


                loadHistoricalData();


            }

            catch(error) {

                currentLat = lat;
                currentLon = lon;

                document.getElementById(
                    "locationName"
                ).textContent =
                    "Your Location";


                loadHistoricalData();

            }

        },


        function(error) {

            alert(
                "Location access was denied.\n\n" +
                "Please allow location permission and try again."
            );

        },

        {

            enableHighAccuracy: true,

            timeout: 10000,

            maximumAge: 300000

        }

    );

}


/* =====================================================
   SEARCH CITY
===================================================== */

async function searchPlace() {

    const query =
        document
        .getElementById("placeInput")
        .value
        .trim();


    if (!query) {

        alert(
            "Enter a city name first."
        );

        return;

    }


    try {

        document.getElementById(
            "locationName"
        ).textContent =
            "Searching...";


        const response =
            await fetch(
                `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=en&format=json`
            );


        const data =
            await response.json();


        if (
            !data.results ||
            data.results.length === 0
        ) {

            throw new Error(
                "Location not found"
            );

        }


        const place =
            data.results[0];


        currentLat =
            place.latitude;

        currentLon =
            place.longitude;


        let locationName =
            place.name;


        if (place.country) {

            locationName +=
                ", " +
                place.country;

        }


        document.getElementById(
            "locationName"
        ).textContent =
            locationName;


        document.getElementById(
            "latitude"
        ).textContent =
            currentLat.toFixed(4) + "°";


        document.getElementById(
            "longitude"
        ).textContent =
            currentLon.toFixed(4) + "°";


        loadHistoricalData();


    }

    catch(error) {

        alert(
            "Location not found. Try another city."
        );

    }

}


/* =====================================================
   LOAD HISTORICAL SOLAR DATA
===================================================== */

async function loadHistoricalData() {

    if (
        currentLat === null ||
        currentLon === null
    ) {

        /*
            Default location:
            Chennai

            The user can immediately
            replace it using
            "Use My Location".
        */

        currentLat = 13.0827;

        currentLon = 80.2707;


        document.getElementById(
            "locationName"
        ).textContent =
            "Chennai, India";


        document.getElementById(
            "latitude"
        ).textContent =
            currentLat.toFixed(4) + "°";


        document.getElementById(
            "longitude"
        ).textContent =
            currentLon.toFixed(4) + "°";

    }


    try {

        const period =
            Number(
                document
                .getElementById("period")
                .value
            );


        /*
            End date = yesterday.

            Historical datasets can have
            a small delay, so yesterday
            is safer than requesting today.
        */

        const end =
            new Date();


        end.setDate(
            end.getDate() - 1
        );


        const start =
            new Date(end);


        start.setDate(
            start.getDate() -
            (period - 1)
        );


        const startDate =
            formatDate(start);

        const endDate =
            formatDate(end);


        /*
            Open-Meteo Historical Weather API

            shortwave_radiation_sum =
            daily solar radiation

            Unit:
            MJ/m²
        */

        const url =
            `https://archive-api.open-meteo.com/v1/archive?` +
            `latitude=${currentLat}` +
            `&longitude=${currentLon}` +
            `&start_date=${startDate}` +
            `&end_date=${endDate}` +
            `&daily=shortwave_radiation_sum` +
            `&timezone=auto`;


        const response =
            await fetch(url);


        if (!response.ok) {

            throw new Error(
                "Historical data unavailable"
            );

        }


        const data =
            await response.json();


        const dates =
            data.daily.time;


        const radiation =
            data.daily.shortwave_radiation_sum;


        /*
            Remove null values.
        */

        const validValues =
            radiation.filter(
                value =>
                    value !== null
            );


        if (
            validValues.length === 0
        ) {

            throw new Error(
                "No historical solar data found."
            );

        }


        /* =================================================
           AVERAGE
        ================================================= */

        const total =
            validValues.reduce(
                (sum, value) =>
                    sum + value,
                0
            );


        const average =
            total /
            validValues.length;


        document.getElementById(
            "average"
        ).textContent =
            average.toFixed(1)
            + " MJ/m²";


        /* =================================================
           HIGHEST
        ================================================= */

        const highest =
            Math.max(
                ...validValues
            );


        document.getElementById(
            "highest"
        ).textContent =
            highest.toFixed(1)
            + " MJ/m²";


        /* =================================================
           LOWEST
        ================================================= */

        const lowest =
            Math.min(
                ...validValues
            );


        document.getElementById(
            "lowest"
        ).textContent =
            lowest.toFixed(1)
            + " MJ/m²";


        /* =================================================
           TIMEZONE
        ================================================= */

        document.getElementById(
            "timezone"
        ).textContent =
            data.timezone;


        /* =================================================
           CREATE GRAPH
        ================================================= */

        createChart(
            dates,
            radiation
        );

    }

    catch(error) {

        console.error(error);

        alert(
            "Unable to load historical solar data."
        );

    }

}


/* =====================================================
   CREATE CHART
===================================================== */

function createChart(
    dates,
    radiation
) {


    const canvas =
        document.getElementById(
            "solarChart"
        );


    /*
        Destroy old chart
        before creating a new one.
    */

    if (solarChart) {

        solarChart.destroy();

    }


    solarChart =
        new Chart(
            canvas,
            {

                type: "line",


                data: {

                    labels:
                        dates.map(
                            date => {

                                const d =
                                    new Date(
                                        date +
                                        "T00:00:00"
                                    );

                                return d.toLocaleDateString(
                                    [],
                                    {
                                        day: "2-digit",
                                        month: "short"
                                    }
                                );

                            }
                        ),


                    datasets: [

                        {

                            label:
                                "Solar Radiation (MJ/m²)",


                            data:
                                radiation,


                            borderColor:
                                "#ffc43d",


                            backgroundColor:
                                "rgba(255,196,61,0.15)",


                            borderWidth:
                                3,


                            pointRadius:
                                3,


                            pointBackgroundColor:
                                "#ffd75a",


                            fill:
                                true,


                            tension:
                                0.35

                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,


                    interaction: {

                        intersect: false,

                        mode: "index"

                    },


                    plugins: {

                        legend: {

                            labels: {

                                color:
                                    "#a9bacb"

                            }

                        },


                        tooltip: {

                            backgroundColor:
                                "#071b30",

                            borderColor:
                                "#24658e",

                            borderWidth:
                                1,

                            titleColor:
                                "#ffffff",

                            bodyColor:
                                "#d8e3ed"

                        }

                    },


                    scales: {

                        x: {

                            ticks: {

                                color:
                                    "#71879c",

                                maxTicksLimit:
                                    10

                            },

                            grid: {

                                color:
                                    "rgba(255,255,255,0.05)"

                            }

                        },


                        y: {

                            beginAtZero: true,

                            title: {

                                display: true,

                                text:
                                    "MJ/m²",

                                color:
                                    "#91a6ba"

                            },

                            ticks: {

                                color:
                                    "#71879c"

                            },

                            grid: {

                                color:
                                    "rgba(255,255,255,0.05)"

                            }

                        }

                    }

                }

            }

        );

}


