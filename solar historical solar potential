<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SolarQuest - Historical Solar Potential</title>

<style>

/* =====================================================
   RESET
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: white;
    min-height: 100vh;

    background:
        radial-gradient(
            circle at 75% 10%,
            rgba(255, 180, 50, 0.13),
            transparent 25%
        ),
        radial-gradient(
            circle at 10% 90%,
            rgba(0, 130, 255, 0.15),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #020b18,
            #061b32 50%,
            #03101f
        );
}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {

    position: fixed;

    left: 0;
    top: 0;

    width: 225px;
    height: 100vh;

    padding: 22px 15px;

    background:
        rgba(2, 12, 27, 0.95);

    border-right:
