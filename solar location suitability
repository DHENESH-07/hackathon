<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SolarQuest - Location Suitability</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #07111f;
    color: white;
    min-height: 100vh;
}

/* SIDEBAR */
.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 245px;
    height: 100vh;
    background: linear-gradient(180deg, #0b1b31, #06101d);
    border-right: 1px solid #183452;
    padding: 25px 15px;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #ffd54a;
    margin-bottom: 35px;
    padding-left: 15px;
}

.logo span {
    color: #42d9ff;
}

.menu-title {
    color: #66809d;
    font-size: 11px;
    margin: 20px 15px 10px;
    text-transform: uppercase;
}

.menu-item {
    padding: 13px 15px;
    margin: 5px 0;
    border-radius: 10px;
    color: #9db1c8;
    cursor: pointer;
    transition: 0.3s;
}

.menu-item:hover {
    background: #102b47;
    color: white;
}

.menu-item.active {
    background: linear-gradient(90deg, #14395d, #10263e);
    color: #ffd54a;
    border-left: 3px solid #ffd54a;
}

/* MAIN */
.main {
    margin-left: 245px;
    padding: 35px;
}

/* HEADER */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.header h1 {
    font-size: 30px;
}

.header p {
    color: #8197ae;
    margin-top: 7px;
}

.location-badge {
    background: #10263e;
    border: 1px solid #214765;
    padding: 10px 16px;
    border-radius: 20px;
    color: #8fdfff;
}

/* HERO */
.hero {
    background: linear-gradient(135deg, #102d4b, #091827);
    border: 1px solid #1c4567;
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 25px;
    position: relative;
    overflow: hidden;
}

.hero::after {
    content: "☀";
    position: absolute;
    right: 40px;
    top: 20px;
    font-size: 110px;
    color: rgba(255, 213, 74, 0.08);
}

.hero h2 {
    font-size: 25px;
    margin-bottom: 10px;
}

.hero p {
    color: #8ca5bd;
    max-width: 650px;
    line-height: 1.6;
}

/* SEARCH */
.search-box {
    display: flex;
    gap: 10px;
    margin-top: 25px;
    position: relative;
    z-index: 2;
}

.search-box input {
    flex: 1;
    padding: 14px 18px;
    border-radius: 10px;
    border: 1px solid #28516f;
    background: #071522;
    color: white;
    outline: none;
    font-size: 15px;
}

.search-box input:focus {
    border-color: #42d9ff;
}

button {
    padding: 14px 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.3s;
}

.search-btn {
    background: #ffd54a;
    color: #101820;
}

.search-btn:hover {
    background: #ffe477;
}

.location-btn {
    background: #153957;
    color: #73dfff;
    border: 1px solid #285a79;
}

.location-btn:hover {
    background: #1b486a;
}

/* SCORE */
.score-card {
    background: linear-gradient(145deg, #102d49, #091827);
    border: 1px solid #23516e;
    border-radius: 20px;
    padding: 28px;
    display: flex;
    align-items: center;
    gap: 30px;
    margin-bottom: 25px;
}

.score-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: conic-gradient(#ffd54a 0deg, #ffd54a 0deg, #18324b 0deg);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    flex-shrink: 0;
}

.score-circle::before {
    content: "";
    width: 118px;
    height: 118px;
    background: #0a1929;
    border-radius: 50%;
    position: absolute;
}

.score-number {
    position: relative;
    z-index: 1;
    text-align: center;
}

.score-number h2 {
    font-size: 38px;
    color: #ffd54a;
}

.score-number span {
    color: #7790a8;
    font-size: 12px;
}

.score-info h2 {
    margin-bottom: 8px;
}

.score-info p {
    color: #8da4ba;
    line-height: 1.6;
}

/* CARDS */
.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.card {
    background: #0c1d30;
    border: 1px solid #1a3b58;
    border-radius: 16px;
    padding: 22px;
}

.card-icon {
    font-size: 25px;
    margin-bottom: 15px;
}

.card-title {
    color: #7890a8;
    font-size: 13px;
    margin-bottom: 8px;
}

.card-value {
    font-size: 25px;
    font-weight: bold;
}

.card-unit {
    color: #7f94a9;
    font-size: 12px;
    margin-top: 5px;
}

/* ANALYSIS */
.analysis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.panel {
    background: #0c1d30;
    border: 1px solid #1a3b58;
    border-radius: 18px;
    padding: 25px;
}

.panel h3 {
    margin-bottom: 20px;
}

.factor {
    margin-bottom: 20px;
}

.factor-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}

.factor-name {
    color: #a4b6c8;
}

.factor-score {
    color: #ffd54a;
    font-weight: bold;
}

.progress {
    height: 8px;
    background: #172c40;
    border-radius: 10px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #ffd54a, #ff9d3c);
    border-radius: 10px;
    transition: width 0.8s;
}

/* LOCATION INFO */
.location-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.info-box {
    background: #081725;
    border: 1px solid #183850;
    border-radius: 10px;
    padding: 15px;
}

.info-box small {
    color: #6e879e;
}

.info-box p {
    margin-top: 5px;
    color: #d8e5f0;
}

/* INSIGHT */
.insight {
    margin-top: 20px;
    background: linear-gradient(90deg, #142f42, #102537);
    border-left: 4px solid #42d9ff;
    padding: 18px;
    border-radius: 10px;
    color: #b5c9d9;
    line-height: 1.6;
}

/* LOADING */
.loading {
    text-align: center;
    padding: 20px;
    color: #7d96ae;
    display: none;
}

.error {
    background: #3b2024;
    color: #ff9d9d;
    border: 1px solid #74373d;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 20px;
    display: none;
}

/* RESPONSIVE */
@media(max-width: 1000px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .analysis {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 700px) {
    .sidebar {
        position: relative;
        width: 100%;
        height: auto;
    }

    .main {
        margin-left: 0;
        padding: 20px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .score-card {
        flex-direction: column;
        text-align: center;
    }

    .search-box {
        flex-direction: column;
    }

    .header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
}
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

    <div class="logo">
        ☀ Solar<span>Quest</span>
    </div>

    <div class="menu-title">Main</div>

    <div class="menu-item">▣ Dashboard</div>
    <div class="menu-item">☀ Solar Analysis</div>
    <div class="menu-item">⚙ Optimizer</div>
    <div class="menu-item">◉ Simulation</div>
    <div class="menu-item">✦ AI Prediction</div>
    <div class="menu-item">▥ Analytics</div>

    <div class="menu-title">Tools</div>

    <div class="menu-item">☼ Weather & Sunlight</div>
    <div class="menu-item active">📍 Location Suitability</div>
    <div class="menu-item">◈ What-If Simulator</div>
    <div class="menu-item">🏆 SolarQuest Challenge</div>

</div>


<!-- MAIN -->
<div class="main">

    <div class="header">
        <div>
            <h1>Location Suitability</h1>
            <p>Analyze whether a location is suitable for solar energy generation.</p>
        </div>

        <div class="location-badge" id="locationBadge">
            📍 Chennai, India
        </div>
    </div>


    <!-- HERO -->
    <div class="hero">

        <h2>📍 Solar Location Analysis</h2>

        <p>
            Enter a city or use your current location to analyze its
            solar energy potential. SolarQuest evaluates sunlight,
            cloud cover, sunshine duration, rainfall and wind conditions.
        </p>

        <div class="search-box">

            <input
                type="text"
                id="cityInput"
                placeholder="Enter city name e.g. Chennai"
            >

            <button class="search-btn" onclick="searchCity()">
