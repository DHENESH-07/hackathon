<script>

/* ================================
   DEFAULT LOCATION
================================ */

let currentLat = 13.0827;
let currentLon = 80.2707;


/* ================================
   LOAD LOCATION
================================ */

async function analyzeLocation(lat, lon, locationName) {

    showLoading(true);
    hideError();

    try {

        const url =
        `https://api.open-meteo.com/v1/forecast?` +
        `latitude=${lat}` +
        `&longitude=${lon}` +
        `&current=temperature_2m,cloud_cover,wind_speed_10m,shortwave_radiation` +
        `&hourly=sunshine_duration,precipitation` +
        `&timezone=auto` +
        `&forecast_days=1`;

        const response = await fetch(url);

        if (!response.ok) {
            throw new Error("Weather data could not be loaded.");
        }

        const data = await response.json();

        const current = data.current;

        const solar = current.shortwave_radiation || 0;
        const cloud = current.cloud_cover || 0;
        const wind = current.wind_speed_10m || 0;

        /*
        Sunshine duration is returned in seconds.
        Convert to hours.
        */

        let sunshineSeconds = 0;

        if (
            data.hourly &&
            data.hourly.sunshine_duration
        ) {

            sunshineSeconds =
                data.hourly.sunshine_duration.reduce(
                    (sum, value) => sum + (value || 0),
                    0
                );

        }

        const sunshineHours =
            sunshineSeconds / 3600;


        /*
        Calculate rainfall.
        */

        let rainfall = 0;

        if (
            data.hourly &&
            data.hourly.precipitation
        ) {

            rainfall =
                data.hourly.precipitation.reduce(
                    (sum, value) => sum + (value || 0),
                    0
                );

        }


        /* ================================
           CALCULATE FACTOR SCORES
        ================================= */

        /*
        Solar radiation:
        0 W/m² = 0
        1000 W/m² = 100
        */

        const solarScore =
            Math.min(100, (solar / 1000) * 100);


        /*
        Sunshine:
        0 hours = 0
        12 hours = 100
        */

        const sunScore =
            Math.min(100, (sunshineHours / 12) * 100);


        /*
        Lower cloud cover is better.
        */

        const cloudScore =
            Math.max(0, 100 - cloud);


        /*
        Weather score.
        Moderate wind and lower rainfall
        are considered favorable.
        */

        let weatherScore = 100;

        if (wind > 30) {
            weatherScore -= 20;
        }

        if (wind > 50) {
            weatherScore -= 20;
        }

        if (rainfall > 5) {
            weatherScore -= 15;
        }

        if (rainfall > 15) {
            weatherScore -= 20;
        }

        weatherScore =
            Math.max(0, weatherScore);


        /*
        Overall score.
        */

        const overallScore = Math.round(
            solarScore * 0.40 +
            sunScore * 0.25 +
            cloudScore * 0.25 +
            weatherScore * 0.10
        );


        /* ================================
           UPDATE UI
        ================================= */

        document.getElementById("score").textContent =
            overallScore;

        document.getElementById("solarRadiation").textContent =
            Math.round(solar);

        document.getElementById("cloudCover").textContent =
            Math.round(cloud);

        document.getElementById("sunshine").textContent =
            sunshineHours.toFixed(1);

        document.getElementById("windSpeed").textContent =
            wind.toFixed(1);


        document.getElementById("latitude").textContent =
            Number(lat).toFixed(4);

        document.getElementById("longitude").textContent =
            Number(lon).toFixed(4);

        document.getElementById("timezone").textContent =
            data.timezone || "--";

        document.getElementById("rainfall").textContent =
            rainfall.toFixed(1) + " mm";


        /* ================================
           FACTOR BARS
        ================================= */

        setFactor(
            "solarFactor",
            "solarBar",
            solarScore
        );

        setFactor(
            "sunFactor",
            "sunBar",
            sunScore
        );

        setFactor(
            "cloudFactor",
            "cloudBar",
            cloudScore
        );

        setFactor(
            "weatherFactor",
            "weatherBar",
            weatherScore
        );


        /* ================================
           SUITABILITY MESSAGE
        ================================= */

        let title;
        let message;

        if (overallScore >= 75) {

            title = "High Solar Potential";

            message =
                "This location currently shows strong solar conditions, with good sunlight availability and relatively favorable weather conditions.";

        }
        else if (overallScore >= 50) {

            title = "Moderate Solar Potential";

            message =
                "This location has moderate solar conditions. Solar installation may require additional analysis of long-term radiation and site conditions.";

        }
        else {

            title = "Lower Solar Potential";

            message =
                "Current weather conditions show lower solar availability. Long-term historical solar data should be checked before making an installation decision.";

        }


        document.getElementById(
            "suitabilityTitle"
        ).textContent = title;

        document.getElementById(
            "suitabilityText"
        ).textContent = message;


        /* ================================
           INSIGHT
        ================================= */

        let insight =
            "💡 SolarQuest analyzed the current atmospheric conditions for this location. ";

        if (solarScore >= 70) {

            insight +=
                "Solar radiation is currently favorable. ";

        }
        else {

            insight +=
                "Solar radiation is currently limited. ";

        }

        if (cloud < 30) {

            insight +=
                "Low cloud cover provides good sunlight availability.";

        }
        else if (cloud < 60) {

            insight +=
                "Moderate cloud cover may reduce solar generation.";

        }
        else {

            insight +=
                "High cloud cover may significantly reduce solar generation.";

        }


        document.getElementById("insight").textContent =
            insight;


        /* ================================
           SCORE CIRCLE
        ================================= */

        const degrees =
            overallScore * 3.6;

        document.getElementById(
            "scoreCircle"
        ).style.background =
            `conic-gradient(
                #ffd54a ${degrees}deg,
                #18324b ${degrees}deg
            )`;


        document.getElementById(
            "locationBadge"
        ).textContent =
            "📍 " + locationName;


        currentLat = lat;
        currentLon = lon;

    }
    catch (error) {

        showError(
            "Unable to analyze this location. Please check the city name or try again."
        );

        console.error(error);

    }
    finally {

        showLoading(false);

    }
}


/* ================================
   SEARCH CITY
================================ */

async function searchCity() {

    const city =
        document.getElementById(
            "cityInput"
        ).value.trim();

    if (!city) {

        showError(
            "Please enter a city name."
        );

        return;

    }

    showLoading(true);
    hideError();

    try {

        const url =
            `https://geocoding-api.open-meteo.com/v1/search?` +
            `name=${encodeURIComponent(city)}` +
            `&count=1&language=en&format=json`;

        const response =
            await fetch(url);

        const data =
            await response.json();

        if (
            !data.results ||
            data.results.length === 0
        ) {

            throw new Error(
                "Location not found."
            );

        }

        const location =
            data.results[0];

        const name =
            location.name;

        const country =
            location.country || "";

        const displayName =
            name + ", " + country;

        await analyzeLocation(
            location.latitude,
            location.longitude,
            displayName
        );

    }
    catch (error) {

        showError(
            "Location not found. Try another city."
        );

        showLoading(false);

    }
}


/* ================================
   USE MY LOCATION
================================ */

function useMyLocation() {

    if (!navigator.geolocation) {

        showError(
            "Geolocation is not supported by your browser."
        );

        return;

    }

    showLoading(true);
    hideError();

    navigator.geolocation.getCurrentPosition(

        async function(position) {

            const lat =
                position.coords.latitude;

            const lon =
                position.coords.longitude;

            try {

                /*
                Reverse geocoding
                */

                const url =
                    `https://geocoding-api.open-meteo.com/v1/search?` +
                    `latitude=${lat}&longitude=${lon}`;

                /*
                Open-Meteo does not provide a simple
                reverse-geocoding endpoint in every setup,
                so use coordinates as fallback.
                */

                await analyzeLocation(
                    lat,
                    lon,
                    "My Location"
                );

            }
            catch (error) {

                showError(
                    "Unable to analyze your location."
                );

                showLoading(false);

            }

        },

        function() {

            showError(
                "Location permission was denied. Please allow location access."
            );

            showLoading(false);

        }

    );
}


/* ================================
   FACTOR BAR
================================ */

function setFactor(
    textId,
    barId,
    value
) {

    const rounded =
        Math.round(value);

    document.getElementById(
        textId
    ).textContent =
        rounded + "%";

    document.getElementById(
        barId
    ).style.width =
        rounded + "%";
}


/* ================================
   LOADING
================================ */

function showLoading(show) {

    document.getElementById(
        "loading"
    ).style.display =
        show ? "block" : "none";

}


/* ================================
   ERROR
================================ */

function showError(message) {

    const box =
        document.getElementById(
            "errorBox"
        );

    box.textContent = message;

    box.style.display = "block";

}


function hideError() {

    document.getElementById(
        "errorBox"
    ).style.display = "none";

}


/* ================================
   ENTER KEY
================================ */

document.getElementById(
    "cityInput"
).addEventListener(
    "keypress",
    function(event) {

        if (event.key === "Enter") {
            searchCity();
        }

    }
);


/* ================================
   LOAD DEFAULT CHENNAI
================================ */

