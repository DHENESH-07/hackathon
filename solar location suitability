        </div>

        <div class="score-info">

            <h2 id="suitabilityTitle">
                Location Suitability
            </h2>

            <p id="suitabilityText">
                Search for a location to calculate its solar suitability.
            </p>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="cards">

        <div class="card">

            <div class="card-icon">☀️</div>

            <div class="card-title">
